{
  "name": "wonderboy",
  "version": "1.0.0",
  "private": true,
  "description": "Fills in Word files with find/replace pairs from an Excel file",
  "author": "JosiahHands",
  "repository": "github:JosiahHands/wonderboy",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsc && electron ."
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "jszip": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.wonderboy.app",
    "productName": "WonderBoy",
    "executableName": "WonderBoy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*.js",
      "index.html",
      "icon.svg",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "include": "installer.nsh",
      "artifactName": "WonderBoy-Setup.${ext}"
    }
  }
}
